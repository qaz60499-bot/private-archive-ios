{
  "name": "telegram-private-media-vault",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev --local --port 8787",
    "dev:worker:e2e": "npx -y -p wrangler@4.127.1 wrangler dev --config wrangler.e2e.toml --local --port 8799 --persist-to .wrangler/e2e-state",
    "dev:worker:e2e:auth": "npx -y -p wrangler@4.127.1 wrangler dev --config wrangler.auth-e2e.toml --local --port 8799 --persist-to .wrangler/e2e-state",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build --mode web",
    "build:ios:web": "tsc -b && vite build --mode ios",
    "ios:sync": "npx cap sync ios",
    "ios:prepare": "npm run build:ios:web && npm run ios:sync",
    "ios:open": "npx cap open ios",
    "build:desktop": "cmd.exe /D /C desktop\\windows\\build-desktop.cmd",
    "cf:detach-legacy-domains": "node scripts/detach-legacy-worker-domains.mjs",
    "cf:cleanup-legacy-photo-dns": "node scripts/cleanup-legacy-photo-dns.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node tests/e2e/run-split.mjs",
    "test:e2e:raw": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply private-archive-db --local",
    "db:migrate:e2e": "node tests/e2e/migrate-e2e.mjs",
    "config:validate": "node D:/wendangcodex/Codex2/home/skills/website-building-workflow/scripts/validate-website-config.mjs website.config.json",
    "check": "npm run config:validate && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "exifr": "latest",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "hono": "latest",
    "idb": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "three": "^0.185.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/ios": "8.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest",
    "vitest": "latest",
    "wrangler": "^4.127.1"
  }
}
